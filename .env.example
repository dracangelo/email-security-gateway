# email-auth-gateway Configuration Template

# Server & Security Settings
APP_ENV=production
WEBHOOK_SHARED_SECRET=change-this-to-a-strong-random-secret
ADMIN_SHARED_SECRET=change-this-to-an-admin-secret
ENCRYPTION_KEY=
WEBHOOK_ALLOWED_SOURCE_IPS=
ADMIN_RATE_LIMIT_MAX_REQUESTS=30

# Tag-Only Observation Mode
ENABLE_TAG_ONLY_MODE=false

# Provider Ingestion Settings
MAILGUN_SIGNING_KEY=

# Executive / VIP Protection (comma-separated list)
VIP_DISPLAY_NAMES=Jane Doe CEO,John Smith CFO

# Storage & Caching
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# Delivery / SMTP Relay
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=false

# External Threat Feeds & Scanners
VIRUSTOTAL_API_KEY=
SAFE_BROWSING_API_KEY=
CLAMAV_HOST=
CLAMAV_PORT=3310

# Audit Logging
ADMIN_AUDIT_LOG_PATH=./admin_audit.jsonl
