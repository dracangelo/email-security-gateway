# ==============================================================================
# email-auth-gateway Configuration Template
# ==============================================================================
# Copy this file to .env and customize values for your environment:
#   cp .env.example .env
#
# All keys, generator commands, and external API portal links are documented below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Security Settings
# ------------------------------------------------------------------------------
# Deployment environment: "development", "staging", or "production"
APP_ENV=production

# Inbound Webhook Shared Secret (Required)
# Protects inbound provider webhooks (/webhooks/sendgrid/inbound/{secret}).
# Generate with one of the following commands:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   openssl rand -hex 32
WEBHOOK_SHARED_SECRET=change-this-to-a-strong-random-secret

# Admin API Bearer Token (Required for production)
# Protects all /admin/* endpoints and the SOC web dashboard.
# Generate with one of the following commands:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   openssl rand -hex 32
ADMIN_SHARED_SECRET=change-this-to-an-admin-secret

# Raw Mail & Quarantine At-Rest Encryption Key (Fernet Key)
# 32 url-safe base64-encoded bytes used to encrypt stored raw .eml files.
# If left empty, raw files are stored unencrypted (acceptable ONLY for dev).
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RAW_MAIL_ENCRYPTION_KEY=
# Alias for backwards compatibility:
ENCRYPTION_KEY=

# Optional Inbound Source IP Allowlist (CIDR notation, comma-separated)
# Restricts inbound webhook POSTs to your provider's published IP ranges.
# E.g. SendGrid IPs: "167.89.0.0/17,198.37.144.0/20"
# Leave empty to disable IP restriction.
WEBHOOK_ALLOWED_SOURCE_IPS=

# Rate Limits (Fixed 60-second window per source IP)
RATE_LIMIT_MAX_REQUESTS=120
ADMIN_RATE_LIMIT_MAX_REQUESTS=60

# ------------------------------------------------------------------------------
# 2. Tag-Only / Shadow Observation Mode
# ------------------------------------------------------------------------------
# When true, the gateway inserts "X-Gateway-Verdict" headers but delivers mail
# without modifying body or moving to quarantine. Recommended for initial rollout.
ENABLE_TAG_ONLY_MODE=false

# ------------------------------------------------------------------------------
# 3. Inbound Mail Provider Credentials & Ingestion
# ------------------------------------------------------------------------------
# Mailgun Webhook HMAC Signing Key
# Get from: https://app.mailgun.com/settings/api_keys
# Docs: https://documentation.mailgun.com/docs/mailgun/user-manual/inbound-routing/
MAILGUN_SIGNING_KEY=

# SendGrid API Key & Inbound Parse Webhook Settings
# Get API Key: https://app.sendgrid.com/settings/api_keys
# Configure Inbound Parse: https://app.sendgrid.com/settings/parse
# Docs: https://docs.sendgrid.com/for-developers/parsing-email/inbound-email
SENDGRID_API_KEY=

# Microsoft 365 / Microsoft Graph API Integration (Optional)
# Portal: Microsoft Entra ID (Azure AD) App Registrations
# Link: https://portal.azure.com/#view/Microsoft_AAD_IAM/ActiveDirectoryMenuBlade/~/RegisteredApps
# Docs: https://learn.microsoft.com/en-us/graph/auth-register-app-overview
# Generate via Azure CLI:
#   az ad app create --display-name "email-auth-gateway"
#   az ad app credential reset --id <APPLICATION_CLIENT_ID>
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# Google Workspace / Gmail API Service Account (Optional)
# Portal: Google Cloud Console Service Accounts
# Link: https://console.cloud.google.com/iam-admin/serviceaccounts
# Delegation: https://admin.google.com/ac/owl/domainwidedelegation
# Generate via gcloud CLI:
#   gcloud iam service-accounts create email-gateway --display-name="Email Gateway Service Account"
#   gcloud iam service-accounts keys create gworkspace-key.json --iam-account=email-gateway@<PROJECT_ID>.iam.gserviceaccount.com
GOOGLE_WORKSPACE_CREDENTIALS_JSON=

# AWS SES / SNS Webhook Ingestion (Optional)
# Portal: AWS IAM Security Credentials & SES Console
# Link: https://console.aws.amazon.com/iam/home#/security_credentials
# SES Console: https://console.aws.amazon.com/ses/home
# Generate via AWS CLI:
#   aws iam create-access-key --user-name email-gateway-ses-user
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# 4. Content Analysis & Threat Intelligence APIs
# ------------------------------------------------------------------------------
# VirusTotal API Key
# Portal: VirusTotal API Key Management Console
# Access API Key: https://www.virustotal.com/gui/my-apikey
# API Documentation: https://developers.virustotal.com/reference/overview
VT_API_KEY=
VIRUSTOTAL_API_KEY=

# Google Safe Browsing / Web Risk API Key
# Portal: Google Cloud Console -> APIs & Services -> Credentials
# Link: https://console.cloud.google.com/apis/credentials
# Enable API: https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
# Documentation: https://developers.google.com/safe-browsing/v4/get-started
# Generate via gcloud CLI:
#   gcloud services enable safebrowsing.googleapis.com
#   gcloud alpha services api-keys create --display-name="SafeBrowsingKey"
GSB_API_KEY=
SAFE_BROWSING_API_KEY=

# ClamAV Antivirus Daemon
# Hostname and port of the running clamd scanner. Empty host disables ClamAV scanning.
# Run locally via Docker:
#   docker run -d --name clamav -p 3310:3310 clamav/clamav:latest
# Or install on Linux:
#   sudo apt-get install clamav-daemon && sudo systemctl start clamav-daemon
CLAMD_HOST=
CLAMD_PORT=3310
CLAMAV_HOST=
CLAMAV_PORT=3310

# ------------------------------------------------------------------------------
# 5. Executive / VIP Protection & Watchlists
# ------------------------------------------------------------------------------
# Comma-separated list of executive or high-value display names to monitor
# for impersonation / display-name spoofing.
VIP_DISPLAY_NAMES=Jane Doe CEO,John Smith CFO

# Comma-separated list of internal or partner domains to watch for typosquatting.
WATCHLIST_DOMAINS=example.com,company.com

# ------------------------------------------------------------------------------
# 6. Storage & Caching
# ------------------------------------------------------------------------------
# Use Redis for distributed rate limiting, deduplication, and reputation cache.
# Set to false to use the built-in in-memory store (single-process dev only).
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0
# Run local Redis via Docker:
#   docker run -d --name redis -p 6379:6379 redis:alpine

# Deduplication and cache TTLs (in seconds)
DEDUPE_TTL_SECONDS=86400
DOMAIN_AGE_CACHE_TTL_SECONDS=21600
REPUTATION_CACHE_TTL_SECONDS=1800

# ------------------------------------------------------------------------------
# 7. Delivery & Outbound SMTP Relay
# ------------------------------------------------------------------------------
# Target SMTP relay hostname. Empty = dry-run mode (scores computed, no email sent).
RELAY_HOST=
RELAY_PORT=25
RELAY_USE_TLS=false
RELAY_START_TLS=true
RELAY_USERNAME=
RELAY_PASSWORD=

# Backwards-compatible aliases:
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=false

# Run local mock SMTP server (Mailpit) via Docker for testing:
#   docker run -d --name mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit

# ------------------------------------------------------------------------------
# 8. Quarantine & Alert Notifications
# ------------------------------------------------------------------------------
QUARANTINE_DIR=/tmp/email-gateway-quarantine

# Slack-compatible Incoming Webhook URL for quarantine alerts
# Portal: Slack API App Management
# Link: https://api.slack.com/apps
# Docs: https://api.slack.com/messaging/webhooks
QUARANTINE_NOTIFY_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 9. Audit Logging
# ------------------------------------------------------------------------------
AUDIT_LOG_PATH=/tmp/email-gateway-audit.jsonl
ADMIN_AUDIT_LOG_PATH=/tmp/email-gateway-admin-audit.jsonl

# ------------------------------------------------------------------------------
# 10. Decision Engine Scoring Thresholds
# ------------------------------------------------------------------------------
WARN_THRESHOLD=30
QUARANTINE_THRESHOLD=70
